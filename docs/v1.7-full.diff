+class _HashingReader:
+    def __init__(self, stream):
+        self.stream = stream
+        self.size = 0
+        self.sha256 = hashlib.sha256()
+
+    def read(self, size=-1):
+        content = self.stream.read(size)
+        if content:
+            self.size += len(content)
+            self.sha256.update(content)
+        return content
